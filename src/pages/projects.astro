---
import PageContainer from "@components/PageContainer.astro";
import BasePageLayout from "@layouts/BasePageLayout.astro";
import Image from "astro/components/Image.astro";

import jack_in_fs4_at_comp26 from "@assets/jack_in_fs4_at_comp26.jpg";
import jack_and_cole_workin_on_firmware_fs4 from "@assets/jack_and_cole_workin_on_firmware_fs4.jpg";
import fs4_ev_active from "@assets/fs4_ev_active.jpg";
import fs4_brake_test from "@assets/fs4_brake_test.jpg";
import temp_sense_working_FS4 from "@assets/temp_sense_working_FS4.jpg";
import FS4_battery_temp_sense_ribbon_cable from "@assets/FS4_battery_temp_sense_ribbon_cable.jpg";
import VCU_in_car_FS4 from "@assets/VCU_in_car_FS4.jpg";
import fs_3_peripheral_boards from "@assets/fs-3_peripheral_boards.jpg";
import mcp2515_deadbeef from "@assets/mcp2515_deadbeef.jpg";
import FS_3_final_debugging from "@assets/FS_3_final_debugging.jpg";
import fs3_accel from "@assets/fs3_accel.jpg";
import telvis from "@assets/Telvis.png";
import sar1 from "@assets/sar1.jpg";
import sar2 from "@assets/sar2.jpg";
import sar4 from "@assets/sar4.jpg";
import nixconf_desktop from "@assets/nixconf_desktop.jpg";
import oracle_main_storage from "@assets/oracle_main_storage.jpg";
import oracle_slime from "@assets/oracle_slime.jpg";
import oracle_wither from "@assets/oracle_wither.jpeg";
import oracle_ice_farm from "@assets/oracle_ice_farm.jpg";
import oracle_conc_end_wiring from "@assets/oracle_conc_end_wiring.jpg";
import oracle_cobble from "@assets/oracle_cobble.jpg";
---

<BasePageLayout title="Projects">
    <PageContainer>
        <div class="box">
            <h2>Projects</h2>

            <p>A bunch of projects I care about:</p>
            <ul>
                <li>
                    <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://github.com/formulaslug/fs-4-firmware"
                        >FS-4 Firmware</a
                    >: Firmware for Formula Slug's latest racecar, FS-4.
                    Including throttle control, BMS, dash screens, data
                    acquisition & logging, traction control, state-of-charge
                    estimation, CAN bus architecture, drivers for various
                    sensors, and the rest of the racecar's logic. I led a team
                    of around 10 firmware developers to design this from the
                    ground up.
                    <br style="margin-bottom: 0.5em" />
                    <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://github.com/formulaslug/fs-4-schematics"
                        >FS-4 Schematics</a
                    >: PCB designs for Formula Slug's latest racecar, FS-4. I
                    implemented our first custom STM32 design, fixed last-second
                    BMS and battery temp sense PCB mistakes, tested nearly every
                    aspect of the electrical system and was instrumental in
                    getting the motor spinning days before competition. This was
                    a monumental team effort that I'm super proud to have
                    contributed to:
                    <div class="photo-container">
                        <Image
                            class="photo"
                            src={fs4_ev_active}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={jack_in_fs4_at_comp26}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={fs4_brake_test}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                    </div>
                    <div class="photo-container">
                        <Image
                            class="photo"
                            src={jack_and_cole_workin_on_firmware_fs4}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={temp_sense_working_FS4}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <!-- <Image -->
                        <!--     class="photo" -->
                        <!--     src={VCU_in_car_FS4} -->
                        <!--     layout="full-width" -->
                        <!--     alt="Jack Nystrom" -->
                        <!-- /> -->
                        <!-- <Image -->
                        <!--     class="photo" -->
                        <!--     src={FS4_battery_temp_sense_ribbon_cable} -->
                        <!--     layout="full-width" -->
                        <!--     alt="Jack Nystrom" -->
                        <!-- /> -->
                    </div>
                </li>
                <li>
                    <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://github.com/formulaslug/fs-3">FS-3</a
                    >: Formula Slug's 2024-2025 racecar, FS-3. I did PCB and
                    firmware design, sensor integration, data analysis, and
                    debugged most electrical components of the car at some
                    point. I also developed a ground-up live telemetry system to
                    analyze racecar data in the browser in realtime.

                    <div class="photo-container">
                        <Image
                            class="photo"
                            src={FS_3_final_debugging}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={fs3_accel}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                    </div>
                    <div class="photo-container">
                        <Image
                            class="photo"
                            src={mcp2515_deadbeef}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={fs_3_peripheral_boards}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={telvis}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                    </div>
                </li>

                <li>
                    <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://github.com/Bvngee/nixconf/tree/main"
                        >nixconf</a
                    >: My perfectly customized NixOS desktop configuration for
                    all of my 4+ host machines. This is the culmination of my
                    years using Linux, learning how OSes work, and my descent
                    into madness trying to build the perfect dev environment
                    (&gt;450 commits deep). At this point I couldn't bear to
                    live without it

                    <div class="photo-container">
                        <Image
                            class="photo"
                            style="object-fit: contain;"
                            src={nixconf_desktop}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                    </div>
                </li>
                <li>
                    <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://github.com/Bvngee/SAR"
                        >Electronics Workshop</a
                    >: I helped develop this new highschool class doing
                    research, embedded programming, and debugging. I wrote our
                    Micropython libraries, tried a lot of sensors, and did some
                    cool navigation algorithms.

                    <div class="photo-container">
                        <Image
                            class="photo"
                            src={sar4}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={sar2}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={sar1}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                    </div>
                </li>
                <li>
                    <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://github.com/Bvngee/bvngee.com"
                        >bvngee.com</a
                    >: Written and hosted from scratch using only Astro, nginx,
                    and some bash. Automated deployment, manual SSL, etc (see <a
                        href="/writing/website-explanation">this post</a
                    >). Great learning experience
                </li>
                <li>
                    <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://github.com/Bvngee/BvngeeAddons"
                        >BvngeeAddons</a
                    >: My personal set of client-side fixes & features for
                    Minecraft 1.17, including screenshot management utilities,
                    improved boss bar rendering, bug fixes, and more. Made
                    purely for myself to resolve my annoyances with the game
                    client. Also <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://www.curseforge.com/minecraft/mc-mods/coordinate-mod"
                        >CoordinateMod</a
                    >
                    and <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://www.curseforge.com/minecraft/mc-mods/anti-auto-jump"
                        >AntiAutoJump</a
                    >, my first two mods which were published to get around 16k
                    total downloads.
                </li>
                <li>
                    A bunch of other stuff on <a
                        target="_blank"
                        rel="noopener noreferrer"
                        href="https://github.com/Bvngee?tab=repositories&type=source"
                        >GitHub</a
                    >: Experiments, C++/Rust things, assignments, etc.
                </li>
                <li>
                    Once upon a time I ran a technical Minecraft server. We
                    designed record breaking farms, tons of automation, etc. At
                    one point I was reading decombiled Minecraft source code to
                    debug my farm's lag performance. This is definitely what got
                    me into engineering. (2020-2024)

                    <div class="photo-container">
                        <Image
                            class="photo"
                            src={oracle_ice_farm}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={oracle_slime}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={oracle_main_storage}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                    </div>
                    <div class="photo-container">
                        <Image
                            class="photo"
                            src={oracle_cobble}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={oracle_wither}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                        <Image
                            class="photo"
                            src={oracle_conc_end_wiring}
                            layout="full-width"
                            alt="Jack Nystrom"
                        />
                    </div>
                </li>
            </ul>
        </div>
    </PageContainer>
</BasePageLayout>
<style>
    .box {
        padding: 15px;
        border-radius: 10px;
        background-color: var(--bg2);
        box-shadow: rgba(0, 0, 0, 0.25) 0px 5px 10px;
        margin: 20px 0;
    }
    .box > h2 {
        margin-top: 0;
    }
    .box li {
        /* add a little vertical space between bullets */
        margin: 0.5em 0;
    }
    .photo-container {
        display: flex;
        flex-wrap: nowrap;
        margin: 1em;
        margin-left: 0;
        gap: 1em;
        justify-content: center;
    }
    .photo {
        border-radius: 4px;
        aspect-ratio: 3/2;
        max-height: 12em;
        max-width: 50%;
        min-width: 0;
        /* object-fit: contain; */
    }
</style>
